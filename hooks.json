{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "python \"C:/Users/Admin/.codebuddy/skills/workbuddy-pet/scripts/pet_launch.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"C:/Users/Admin/.codebuddy/skills/workbuddy-pet/scripts/pet_bridge.py\" thinking \"正在思考...\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"C:/Users/Admin/.codebuddy/skills/workbuddy-pet/scripts/pet_bridge.py\" running \"工作中...\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"C:/Users/Admin/.codebuddy/skills/workbuddy-pet/scripts/pet_bridge.py\" waving \"完成！\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
